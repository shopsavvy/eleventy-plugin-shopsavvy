{
  "name": "eleventy-plugin-shopsavvy",
  "version": "0.1.0",
  "description": "Eleventy plugin with shortcodes and global data for product cards, deal feeds, and price history powered by ShopSavvy",
  "keywords": [
    "eleventy",
    "11ty",
    "eleventy-plugin",
    "shopsavvy",
    "products",
    "pricing",
    "shopping",
    "ecommerce"
  ],
  "homepage": "https://shopsavvy.com/integrations/eleventy",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopsavvy/eleventy-plugin-shopsavvy"
  },
  "license": "MIT",
  "author": "ShopSavvy by Monolith Technologies, Inc.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --cjsInterop --splitting",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@11ty/eleventy": ">=2.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
